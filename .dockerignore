# Secrets — never bake these into an image
.env
.env.*

# Version control / local tooling
.git/
.github/
.venv/
venv/
node_modules/
.vscode/
.idea/
.claude/

# Python artifacts
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Runtime artifacts / local-only
logs/
docker-compose.yml

# Docs and tests (not needed at runtime)
docs/
tests/
README.md
LICENSE
